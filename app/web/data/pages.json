[
  {
    "id": "elec",
    "name": "ELEC",
    "lines": [
      {
        "title": "ELEC"
      },
      {
        "label": "AC BUS 1"
      },
      {
        "text": "        VOLT 115  FREQ 400",
        "when": {
          "var": "bus.ac1"
        },
        "level": "normal",
        "only": {
          "var": "bus.ac1"
        }
      },
      {
        "text": "        VOLT 0  FREQ 0",
        "when": {
          "not": {
            "var": "bus.ac1"
          }
        },
        "level": "caution",
        "only": {
          "not": {
            "var": "bus.ac1"
          }
        }
      },
      {
        "label": "AC BUS 2"
      },
      {
        "text": "        VOLT 115  FREQ 400",
        "when": {
          "var": "bus.ac2"
        },
        "level": "normal",
        "only": {
          "var": "bus.ac2"
        }
      },
      {
        "text": "        VOLT 0  FREQ 0",
        "when": {
          "not": {
            "var": "bus.ac2"
          }
        },
        "level": "caution",
        "only": {
          "not": {
            "var": "bus.ac2"
          }
        }
      },
      {
        "label": "AC ESS"
      },
      {
        "text": "        NOT POWERED",
        "when": {
          "not": {
            "var": "bus.acEss"
          }
        },
        "level": "caution"
      },
      {
        "label": "DC BAT"
      },
      {
        "text": "        NOT POWERED",
        "when": {
          "not": {
            "var": "bus.dcBat"
          }
        },
        "level": "caution"
      },
      {
        "label": "GEN 1"
      },
      {
        "text": "        OFF LINE",
        "when": {
          "not": {
            "var": "ctr.gen1"
          }
        },
        "level": "advisory"
      },
      {
        "label": "GEN 2"
      },
      {
        "text": "        OFF LINE",
        "when": {
          "not": {
            "var": "ctr.gen2"
          }
        },
        "level": "advisory"
      },
      {
        "label": "EXT PWR"
      },
      {
        "text": "        AVAIL",
        "when": {
          "not": {
            "var": "ctr.extPwr"
          }
        },
        "level": "advisory"
      }
    ]
  },
  {
