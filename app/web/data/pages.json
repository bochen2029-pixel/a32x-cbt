  {
    "id": "press",
    "name": "PRESS",
    "lines": [
      {
        "title": "PRESS"
      },
      {
        "label": "CABIN ALT"
      },
      {
        "text": "        {{press.cabinAlt}} FT",
        "when": {
          "gt": {
            "var": "press.cabinAlt",
            "value": 9550
          }
        },
        "level": "warning"
      },
      {
        "label": "CABIN V/S"
      },
      {
        "text": "        {{press.cabinVs}} FPM"
      },
      {
        "label": "DIFF PR"
      },
      {
        "text": "        {{press.diffPsi:1}} PSI",
        "when": {
          "gt": {
            "var": "press.diffPsi",
            "value": 8.5
          }
        },
        "level": "warning"
      },
      {
        "label": "OUTFLOW"
      },
      {
        "text": "        {{press.outflow}} %"
      },
      {
        "label": "MODE"
      },
      {
        "text": "        MANUAL",
        "when": {
          "not": {
            "var": "sys.pressAuto"
          }
        },
        "level": "advisory",
        "only": {
          "not": {
            "var": "sys.pressAuto"
          }
        }
      },
      {
        "text": "        AUTO",
        "when": {
          "var": "sys.pressAuto"
        },
        "level": "normal",
        "only": {
          "var": "sys.pressAuto"
        }
      }
    ]
  }
