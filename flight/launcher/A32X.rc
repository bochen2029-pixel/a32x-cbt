// A32X.exe's version resource: what Explorer shows under Properties, Details. GPLv3.
// The version numbers come from CMakeLists.txt's project().

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     A32X_VERSION_MAJOR, A32X_VERSION_MINOR, A32X_VERSION_PATCH, 0
 PRODUCTVERSION  A32X_VERSION_MAJOR, A32X_VERSION_MINOR, A32X_VERSION_PATCH, 0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName",      "A32X CBT flight simulator"
      VALUE "ProductVersion",   A32X_VERSION
      VALUE "FileDescription",  "A32X: opens the flight simulator in Microsoft Edge"
      VALUE "FileVersion",      A32X_VERSION
      VALUE "InternalName",     "A32X"
      VALUE "OriginalFilename", "A32X.exe"
      VALUE "LegalCopyright",   "Free software under the GNU General Public License, version 3"
      VALUE "Comments",         "Unofficial. Not affiliated with Airbus, FlyByWire Simulations or Aerowinx. Not for type training."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
