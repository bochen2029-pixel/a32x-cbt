  <propulsion>
    <!-- ===== The thrust the fitter tunes: shares of the 25,000 lbf take-off rating ===== -->

    <!-- take-off thrust, delta^x (1 + a1 Mach + a2 Mach^2) (1 + c Mach (1 - delta)), and idle thrust,
         delta (i0 + i1 Mach): Engines/CFM56-5A1-fit.xml -->
    <property value="0.34870938" persistent="true">propulsion/fit/lapse-delta</property>
    <property value="-1.1964355" persistent="true">propulsion/fit/lapse-mach</property>
    <property value="1.5525532" persistent="true">propulsion/fit/lapse-mach2</property>
    <property value="-0.98107818" persistent="true">propulsion/fit/lapse-mach-delta</property>
    <property value="0.087183774" persistent="true">propulsion/fit/idle</property>
    <property value="-0.24100822" persistent="true">propulsion/fit/idle-mach</property>
    <!-- ground idle and reverse thrust, for the harness to read: provisional, see thrust-seeds.csv. The
         selector the harness writes, 0 for the flight idle above and 1 for ground idle; declared, it turns
         ground idle on (the harness parks and rolls an airframe that has it at 1) -->
    <property value="0.03" persistent="true">propulsion/fit/ground-idle</property>
    <property value="0.3" persistent="true">propulsion/fit/reverse-efficiency</property>
