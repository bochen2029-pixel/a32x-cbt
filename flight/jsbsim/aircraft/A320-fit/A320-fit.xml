    <!-- A32NX's tanks, its gallons at 6.7 lb each: centre 2179, inner 1816, outer 228 -->
    <tank type="FUEL" number="0">
      <location unit="IN">
        <x> 604 </x>
        <y> 0 </y>
        <z> -50 </z>
      </location>
      <type> JET-A </type>
      <priority> 1 </priority>
      <capacity unit="LBS"> 14599 </capacity>
      <contents unit="LBS"> 2577 </contents>
    </tank>
    <tank type="FUEL" number="1">
      <location unit="IN">
        <x> 646 </x>
