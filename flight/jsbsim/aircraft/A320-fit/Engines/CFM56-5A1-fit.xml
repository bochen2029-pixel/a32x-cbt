<?xml version="1.0"?>
<!--
  The A320-211's engine, the CFM56-5A1, for JSBSim, fitted to the thrust rows of
  flight/targets/a320.csv. GPLv3, like everything in flight/.

  Written for this project. It replaces Aeromatic's CFM56_5, from the JSBSim clone, as our A320's
  engine and keeps everything of it but the thrust and the pace of spool-up: rating, bypass ratio, fuel
  consumption, spool-down. CFM56_5's tables are where the fit started; the numbers below were first
  fitted to them, and those are the seeds (flight/jsbsim/aircraft/A320-fit/thrust-seeds.csv). Spool-up
  is JSBSim's own rate times one fitted number (below, and spool-seeds.csv).

  JSBSim's turbine makes thrust = milthrust (I + (1 - I) M n^2), where I is the IdleThrust function, M
  the MilThrust function and n runs from 0 at idle to 1 at full throttle. Here, as shares of the rating,
  with delta the pressure ratio and Mach the flight Mach number:

    take-off thrust  T = delta^x (1 + a1 Mach + a2 Mach^2) (1 + (c Mach + c2 Mach^2) (1 - delta))
    idle thrust      I = delta ((1 - g) (i0 + i1 Mach) + g ground-idle)

  where g, propulsion/a320/ground-idle, is 0 for the flight idle the fit found and 1 for ground idle,
  the harness's to write; A320-fit.xml declares it at 0, so that left alone the idle is the fit's.

  and MilThrust is (T - I) / (1 - I), so that take-off thrust is the rating times T. Their seven numbers
  are properties declared in A320-fit.xml under propulsion/fit/, beside the thrust lever schedule the
  harness reads there; the fitter (flight/harness/fit.cpp) rewrites them in that file, not here.

    rating       EASA TCDS E.067: the CFM56-5-A1 11,120 daN for take-off, static, sea level, ISA
    the rest     Aeromatic's CFM56_5, unchanged

  Idle may be less than nothing: at speed a turbofan at idle drags more air than it pushes, as Airbus's
  idle thrust for the A320-211 in the ANP database does above about 215 kt.

  Built from public data and estimates, for education and entertainment; not endorsed by CFM
  International or Airbus, not to be sold. This project sells nothing.
-->
<turbine_engine name="CFM56-5A1-fit">
  <milthrust unit="LBS"> 25000.0 </milthrust>
  <bypassratio>     5.9 </bypassratio>
  <tsfc>            0.657 </tsfc>
  <idlen1>         30.0 </idlen1>
  <idlen2>         60.0 </idlen2>
  <maxn1>         100.0 </maxn1>
  <maxn2>         100.0 </maxn2>
  <augmented>         0 </augmented>
  <injected>          0 </injected>

  <function name="IdleThrust">
    <description>idle thrust as a share of the rating: delta ((1 - g) (i0 + i1 Mach) + g ground-idle)</description>
    <product>
      <property>atmosphere/delta</property>
      <sum>
        <product>
          <difference>
            <value>1</value>
            <property>propulsion/a320/ground-idle</property>
          </difference>
          <sum>
            <property>propulsion/fit/idle</property>
            <product>
              <property>propulsion/fit/idle-mach</property>
              <property>velocities/mach</property>
            </product>
          </sum>
        </product>
        <product>
          <property>propulsion/a320/ground-idle</property>
          <property>propulsion/fit/ground-idle</property>
        </product>
      </sum>
    </product>
  </function>

  <function name="MilThrust">
    <description>(T - I) / (1 - I): take-off thrust T as a share of the rating, less idle</description>
    <quotient>
      <difference>
        <product>
          <pow>
            <property>atmosphere/delta</property>
            <property>propulsion/fit/lapse-delta</property>
          </pow>
          <sum>
            <value>1</value>
            <product>
              <property>propulsion/fit/lapse-mach</property>
              <property>velocities/mach</property>
            </product>
            <product>
              <property>propulsion/fit/lapse-mach2</property>
              <property>velocities/mach</property>
              <property>velocities/mach</property>
            </product>
          </sum>
          <sum>
            <value>1</value>
            <product>
              <property>propulsion/fit/lapse-mach-delta</property>
              <property>velocities/mach</property>
              <difference>
                <value>1</value>
                <property>atmosphere/delta</property>
              </difference>
            </product>
            <product>
              <property>propulsion/fit/lapse-mach2-delta</property>
              <property>velocities/mach</property>
              <property>velocities/mach</property>
              <difference>
                <value>1</value>
                <property>atmosphere/delta</property>
              </difference>
            </product>
          </sum>
        </product>
        <property>propulsion/engine[#]/IdleThrust</property>
      </difference>
      <difference>
        <value>1</value>
        <property>propulsion/engine[#]/IdleThrust</property>
      </difference>
    </quotient>
  </function>

  <!-- The pace of spool-up: JSBSim's own rate, as it spools an engine that names none (FGSpoolUp,
       FGTurbine.h), times propulsion/fit/spool-up. 90 / (bypass ratio + 3) per cent a second, 5.9 here,
       slowed near idle and in thin air: / (1 + 3 (1 - n)^3 + (1 - sigma)), n = min(1, N2norm + 0.1), N2norm
       the share of the way from idle N2 to full, (N2 - 60) / 40. At 1 the engine spools as JSBSim's
       default does; N1 spools at N2's rate, as there. Spool-down stays JSBSim's own. -->
  <function name="N2SpoolUp">
    <description>N2's spool-up rate, per cent a second</description>
    <product>
      <property>propulsion/fit/spool-up</property>
      <quotient>
        <quotient>
          <value>90</value>
          <value>8.9</value>
        </quotient>
        <sum>
          <value>1</value>
          <product>
            <value>3</value>
            <pow>
              <difference>
                <value>1</value>
                <min>
                  <value>1</value>
                  <sum>
                    <quotient>
                      <difference>
                        <property>propulsion/engine[#]/n2</property>
                        <value>60</value>
                      </difference>
                      <value>40</value>
                    </quotient>
                    <value>0.1</value>
                  </sum>
                </min>
              </difference>
              <value>3</value>
            </pow>
          </product>
          <difference>
            <value>1</value>
            <property>atmosphere/sigma</property>
          </difference>
        </sum>
      </quotient>
    </product>
  </function>

  <function name="N1SpoolUp">
    <description>N1's spool-up rate, per cent a second: N2's, as JSBSim's default has it</description>
    <property>propulsion/engine[#]/N2SpoolUp</property>
  </function>
</turbine_engine>
